---
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentPath = Astro.url.pathname;

// Determine current locale
let currentLocale = 'id'; // default
if (currentPath.startsWith('/en')) {
  currentLocale = 'en';
} else if (currentPath.startsWith('/ko')) {
  currentLocale = 'ko';
}

// Get the path without locale prefix
const pathWithoutLocale = currentPath.startsWith('/en/') 
  ? currentPath.replace('/en', '') 
  : currentPath.startsWith('/ko/')
  ? currentPath.replace('/ko', '')
  : currentPath.startsWith('/en') && currentPath === '/en'
  ? '/'
  : currentPath.startsWith('/ko') && currentPath === '/ko'
  ? '/'
  : currentPath;

// Generate URLs for all locales
const idUrl = getRelativeLocaleUrl('id', pathWithoutLocale);
const enUrl = getRelativeLocaleUrl('en', pathWithoutLocale);
const koUrl = getRelativeLocaleUrl('ko', pathWithoutLocale);

// Define languages with their properties
const languages = [
  { code: 'id', name: 'ID', flag: 'emojione:flag-for-indonesia', url: idUrl },
  { code: 'ko', name: 'KO', flag: 'emojione:flag-for-south-korea', url: koUrl },
  { code: 'en', name: 'EN', flag: 'emojione:flag-for-united-states', url: enUrl },
];

const currentLanguage = languages.find(lang => lang.code === currentLocale);

// Check if current page has dark hero for styling
const isDarkHeroPage = currentPath.includes('/products') || currentPath.includes('/about') || currentPath.includes('/contact');
---

<div 
  class={`relative inline-block`}
  x-data="{ open: false }"
  x-on:click.away="open = false"
>
  <!-- Dropdown Button -->
  <button 
    class={`flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-300 ${
      isDarkHeroPage 
        ? 'bg-white/20 backdrop-blur-sm text-white/90 hover:text-white [&.scrolled]:bg-muted-100 [&.scrolled]:text-muted-700' 
        : 'bg-muted-100 text-muted-600 hover:text-muted-700'
    }`}
    x-bind:class="scrolled ? 'scrolled' : ''"
    x-on:click="open = !open"
    type="button"
  >
    <iconify-icon icon={currentLanguage?.flag} class="w-4 h-4"></iconify-icon>
    <span>{currentLanguage?.name}</span>
    <iconify-icon 
      icon="heroicons:chevron-down" 
      class="w-3 h-3 transition-transform duration-200"
      x-bind:class="open ? 'rotate-180' : ''"
    ></iconify-icon>
  </button>

  <!-- Dropdown Menu -->
  <div 
    class={`absolute top-full right-0 mt-1 w-20 rounded-lg border shadow-lg overflow-hidden transition-all duration-200 ${
      isDarkHeroPage 
        ? 'bg-white/95 backdrop-blur-sm border-white/20' 
        : 'bg-white border-muted-200'
    }`}
    x-show="open"
    x-transition:enter="opacity-0 transform scale-95"
    x-transition:enter-end="opacity-100 transform scale-100"
    x-transition:leave="opacity-100 transform scale-100"
    x-transition:leave-end="opacity-0 transform scale-95"
    style="display: none;"
  >
    {languages.map((lang) => (
      <a 
        href={lang.url}
        class={`flex items-center gap-2 px-3 py-2 text-xs font-medium transition-colors duration-200 ${
          currentLocale === lang.code 
            ? 'bg-primary-600 text-white' 
            : 'text-muted-600 hover:bg-muted-50 hover:text-muted-700'
        }`}
        x-on:click="open = false"
      >
        <iconify-icon icon={lang.flag} class="w-4 h-4"></iconify-icon>
        <span>{lang.name}</span>
      </a>
    ))}
  </div>
</div>